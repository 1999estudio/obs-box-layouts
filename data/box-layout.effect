uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 boxSize;
uniform float2 uvScale;
uniform float2 uvOffset;
uniform float radius;
uniform float borderWidth;
uniform float4 borderColor;

sampler_state linearSampler {
	Filter = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

VertData VSDefault(VertData vert_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv = vert_in.uv;
	return vert_out;
}

float roundedDistance(float2 point, float2 halfSize, float cornerRadius)
{
	float2 q = abs(point) - halfSize + cornerRadius;
	return length(max(q, float2(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - cornerRadius;
}

float4 PSRoundedBox(VertData vert_in) : TARGET
{
	float2 sourceUV = uvOffset + vert_in.uv * uvScale;
	float4 sampledColor = image.Sample(linearSampler, sourceUV);
	float2 point = (vert_in.uv - 0.5) * boxSize;
	float signedDistance = roundedDistance(point, boxSize * 0.5, radius);
	float outerMask = 1.0 - smoothstep(-0.75, 0.75, signedDistance);
	float innerMask = 1.0 - smoothstep(-0.75, 0.75, signedDistance + borderWidth);
	float borderMask = max(outerMask - innerMask, 0.0);
	float4 premultipliedBorder = float4(borderColor.rgb * borderColor.a, borderColor.a);
	return sampledColor * innerMask + premultipliedBorder * borderMask;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader = PSRoundedBox(vert_in);
	}
}
